# Environment variables for the Darsh Gangakhedkar portfolio.
#
# IMPORTANT: this site is fully static. It has NO runtime environment
# variables and NO server. Nothing here is read by the published page.
#
# These keys exist only for the local build/deploy helper scripts, and
# every one of them is OPTIONAL. The site builds and deploys without any
# of them being set.

# Canonical site origin, used when generating absolute URLs for
# <link rel="canonical"> and Open Graph / Twitter preview tags.
# Default: https://darshmello.github.io
SITE_URL=https://darshmello.github.io

# Only needed if you push with a script instead of the GitHub CLI or
# your OS git credential manager. NEVER commit a real token.
# Create one at https://github.com/settings/tokens with the "repo" scope,
# and export it in your shell only for the duration of the push.
GITHUB_TOKEN=
